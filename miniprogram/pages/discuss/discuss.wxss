/* 讨论列表 · 国风 */
.d-head {
  padding: 8rpx 8rpx 28rpx;
}

.d-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #EFE7D4;
}

.d-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9DB0AB;
  line-height: 1.7;
}

.d-tools {
  margin-bottom: 8rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #16332F;
  border: 2rpx solid rgba(201, 168, 106, 0.25);
  border-radius: 999rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
  color: #EFE7D4;
}

.search-clear {
  font-size: 24rpx;
  color: #9DB0AB;
  padding: 8rpx 0 8rpx 16rpx;
}

.months {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.month {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin-right: 16rpx;
  background: #16332F;
  border: 2rpx solid rgba(201, 168, 106, 0.25);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #CFD9D2;
}

.month-active {
  background: linear-gradient(90deg, #C9A86A, #E3C98E);
  border-color: #C9A86A;
  color: #0E2422;
  font-weight: 600;
}

.empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9DB0AB;
}

.day-fav {
  font-size: 34rpx;
  color: #9DB0AB;
  padding: 0 16rpx 0 0;
  flex-shrink: 0;
}

.day-fav-hover {
  color: #E3C98E;
}

.loading,
.error {
  padding: 60rpx 0;
  text-align: center;
  font-size:26rpx;
  color: #9DB0AB;
}

.day-card {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 28rpx 30rpx;
}

.day-date {
  width: 110rpx;
  flex-shrink: 0;
  text-align: center;
}

.day-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #C9A86A;
  line-height: 1.1;
}

.day-month {
  margin-top: 6rpx;
  font-size: 19rpx;
  color: #9DB0AB;
}

.day-body {
  flex: 1;
  margin-left: 24rpx;
  padding-right: 16rpx;
}

.day-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #EFE7D4;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.day-meta {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #9DB0AB;
}

.day-arrow {
  font-size: 40rpx;
  color: #9DB0AB;
}
