/* 技巧详情 · 国风 */
.head {
  padding: 16rpx 8rpx 24rpx;
}

.cat {
  display: inline-block;
  background: rgba(201, 168, 106, 0.16);
  color: #E3C98E;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.title {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #EFE7D4;
  line-height: 1.4;
}

.body {
  padding: 36rpx 32rpx;
}

.para {
  font-size: 29rpx;
  color: #CFD9D2;
  line-height: 1.85;
  margin-bottom: 20rpx;
}

.para:last-child {
  margin-bottom: 0;
}

.link-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 28rpx 32rpx;
}

.link-text {
  font-size: 27rpx;
  font-weight: 600;
  color: #E3C98E;
  flex: 1;
  padding-right: 20rpx;
}

.link-go {
  font-size: 24rpx;
  color: #9DB0AB;
}
