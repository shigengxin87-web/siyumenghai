/* 社群工具 · 国风 */
.tools-page { min-height: 100vh; padding: 28rpx; box-sizing: border-box; background: #0E2422; }
.tools-hero { padding: 28rpx 7rpx 30rpx; }
.kicker { display: block; color: #C9A86A; font-size: 20rpx; font-weight: 850; letter-spacing: 2rpx; }
.title { display: block; margin: 8rpx 0; font-size: 48rpx; font-weight: 950; color: #EFE7D4; }
.desc { display: block; color: #9DB0AB; font-size: 24rpx; line-height: 1.7; }
.video-card { padding: 28rpx; border-radius: 29rpx; background: linear-gradient(145deg, #102725, #1A3A37); color: #EFE7D4; border: 1rpx solid rgba(201,168,106,.3); box-shadow: 0 16rpx 38rpx rgba(0,0,0,.4); }
.tool-row { display: flex; align-items: flex-start; }
.tool-icon { display: flex; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; border-radius: 23rpx; font-size: 31rpx; font-weight: 900; }
.tool-icon.is-video { background: rgba(201,168,106,.18); color: #E3C98E; }
.tool-copy { min-width: 0; flex: 1; margin-left: 19rpx; }
.tool-label, .tool-title, .tool-desc { display: block; }
.tool-label { color: #C9A86A; font-size: 19rpx; font-weight: 800; letter-spacing: 1rpx; }
.video-card .tool-label { color: #E3C98E; }
.tool-title { margin-top: 5rpx; font-size: 30rpx; font-weight: 900; color: #EFE7D4; }
.tool-desc { margin-top: 8rpx; color: #9DB0AB; font-size: 22rpx; line-height: 1.58; }
.video-card .tool-desc { color: rgba(239,231,212,.8); }
.video-card button { width: 100%; height: 70rpx; margin: 22rpx 0 0; border-radius: 35rpx; background: linear-gradient(90deg,#C9A86A,#E3C98E); color: #0E2422; font-size: 23rpx; font-weight: 800; line-height: 70rpx; }
.section-title { display: flex; justify-content: space-between; padding: 39rpx 5rpx 17rpx; }
.section-title text:first-child { font-size: 31rpx; font-weight: 900; color: #E3C98E; }
.section-title text:last-child { color: #9DB0AB; font-size: 21rpx; }
.knowledge-card { margin-bottom: 14rpx; padding: 25rpx; border: 1rpx solid rgba(201,168,106,0.28); border-radius: 25rpx; background: linear-gradient(160deg,#163330,#102725); box-shadow: 0 9rpx 25rpx rgba(0,0,0,.35); }
.tool-icon.is-ima { background: #e9f4ff; color: #2b74c8; }
.tool-icon.is-feishu { background: #edf0ff; color: #4e60d8; }
.knowledge-card button { width: 180rpx; height: 58rpx; margin: 18rpx 0 0 101rpx; padding: 0; border-radius: 29rpx; background: rgba(201,168,106,.15); color: #E3C98E; font-size: 21rpx; line-height: 58rpx; }
.plain-cell { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 25rpx; border: 1rpx solid rgba(201,168,106,0.28); border-radius: 23rpx; background: linear-gradient(160deg,#163330,#102725); }
.plain-cell > view { min-width: 0; flex: 1; }
.plain-cell > text { color: #C9A86A; font-size: 22rpx; }
.plain-cell .tool-desc { margin-top: 4rpx; }
.notice { margin-top: 28rpx; padding: 25rpx; border-radius: 21rpx; background: rgba(201,168,106,.1); border: 1rpx solid rgba(201,168,106,.25); color: #9DB0AB; font-size: 22rpx; line-height: 1.65; }
.notice text { display: block; }
.notice-title { margin-bottom: 7rpx; color: #E3C98E; font-weight: 850; }

.video-card { margin-bottom: 24rpx; }
