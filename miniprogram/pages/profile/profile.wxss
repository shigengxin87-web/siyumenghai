/* 我的情况（用户档案） · 国风 */
.pf-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx calc(260rpx + env(safe-area-inset-bottom));
  background: #0E2422;
}

.pf-head {
  padding: 4rpx 4rpx 24rpx;
}

.pf-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #EFE7D4;
  margin-bottom: 10rpx;
}

.pf-desc {
  display: block;
  font-size: 25rpx;
  line-height: 1.6;
  color: #9DB0AB;
}

.pf-row {
  background: linear-gradient(160deg, #163330, #102725);
  border: 1rpx solid rgba(201, 168, 106, 0.18);
  border-radius: 18rpx;
  padding: 22rpx 22rpx 12rpx;
  margin-bottom: 16rpx;
}

.pf-label {
  font-size: 27rpx;
  font-weight: 600;
  color: #EFE7D4;
  margin-bottom: 14rpx;
}

.pf-options {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding-bottom: 10rpx;
}

.pf-opt {
  padding: 10rpx 22rpx;
  border-radius: 40rpx;
  background: #16332F;
  color: #CFD9D2;
  font-size: 25rpx;
  line-height: 1.4;
  border: 2rpx solid rgba(201, 168, 106, 0.25);
}

.pf-opt.on {
  background: rgba(201, 168, 106, 0.16);
  color: #E3C98E;
  border-color: #C9A86A;
  font-weight: 600;
}

.pf-empty {
  text-align: center;
  color: #9DB0AB;
  font-size: 26rpx;
  padding: 60rpx 0;
}

.pf-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #16332F;
  border-top: 2rpx solid rgba(201, 168, 106, 0.2);
}

.pf-save {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  background: linear-gradient(90deg, #C9A86A, #E3C98E);
  color: #0E2422;
  font-size: 30rpx;
  font-weight: 600;
}

.pf-save::after {
  border: none;
}

.pf-save[disabled] {
  background: #3A4A45;
  color: #8A9B8A;
}

.pf-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 8rpx 0;
}

.pf-skip,
.pf-clear {
  font-size: 25rpx;
  color: #9DB0AB;
  padding: 6rpx 0;
}

.pf-clear {
  color: #C9695E;
}

/* 手机号授权卡片 */
.pf-phone {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(160deg, #163330, #102725);
  border: 1rpx solid rgba(201, 168, 106, 0.18);
  border-radius: 18rpx;
  padding: 24rpx 22rpx;
  margin-bottom: 16rpx;
}

.pf-phone-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.pf-phone-info {
  display: flex;
  flex-direction: column;
}

.pf-phone-label {
  font-size: 27rpx;
  font-weight: 600;
  color: #EFE7D4;
  margin-bottom: 6rpx;
}

.pf-phone-num {
  font-size: 28rpx;
  color: #E3C98E;
  letter-spacing: 1rpx;
}

.pf-phone-tip {
  font-size: 23rpx;
  line-height: 1.5;
  color: #9DB0AB;
}

.pf-phone-rebind {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: 25rpx;
  color: #9DB0AB;
}

.pf-phone-btn {
  flex-shrink: 0;
  margin: 0 0 0 20rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 36rpx;
  border-radius: 40rpx;
  background: linear-gradient(90deg, #C9A86A, #E3C98E);
  color: #0E2422;
  font-size: 27rpx;
  font-weight: 600;
}

.pf-phone-btn::after {
  border: none;
}
