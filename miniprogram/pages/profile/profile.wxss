/* 我的情况（用户档案） */
.pf-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx calc(200rpx + env(safe-area-inset-bottom));
  background: #F6F8F6;
}

.pf-head {
  padding: 4rpx 4rpx 24rpx;
}

.pf-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #22301F;
  margin-bottom: 10rpx;
}

.pf-desc {
  display: block;
  font-size: 25rpx;
  line-height: 1.6;
  color: #6B8177;
}

.pf-row {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 22rpx 22rpx 12rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 18rpx rgba(30, 90, 30, 0.05);
}

.pf-label {
  font-size: 27rpx;
  font-weight: 600;
  color: #22301F;
  margin-bottom: 14rpx;
}

.pf-options {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding-bottom: 10rpx;
}

.pf-opt {
  padding: 10rpx 22rpx;
  border-radius: 40rpx;
  background: #F2F6F2;
  color: #4B6153;
  font-size: 25rpx;
  line-height: 1.4;
  border: 2rpx solid transparent;
}

.pf-opt.on {
  background: #E8F3E8;
  color: #1F5B26;
  border-color: #2E7D32;
  font-weight: 600;
}

.pf-empty {
  text-align: center;
  color: #A9B8A9;
  font-size: 26rpx;
  padding: 60rpx 0;
}

.pf-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 2rpx solid #EAF0EA;
}

.pf-save {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  background: #2E7D32;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
}

.pf-save::after {
  border: none;
}

.pf-save[disabled] {
  background: #C5D6C5;
  color: #FFFFFF;
}

.pf-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 8rpx 0;
}

.pf-skip,
.pf-clear {
  font-size: 25rpx;
  color: #8A9B8A;
  padding: 6rpx 0;
}

.pf-clear {
  color: #B4645A;
}
