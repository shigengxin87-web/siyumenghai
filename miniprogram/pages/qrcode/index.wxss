/* 领课二维码页样式 */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F0F7F0 0%, #FFFFFF 40%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx 80rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 50rpx;
}

.tag {
  display: inline-block;
  background: #E8F5E8;
  color: #2E7D32;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  margin-bottom: 18rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A2E1A;
}

.course-name {
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #3E8E4E;
}

.subtitle {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #7A8A7A;
}

.card {
  width: 100%;
  max-width: 620rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 60rpx rgba(30, 90, 30, 0.10);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr {
  width: 100%;
  border-radius: 20rpx;
}

.qr-tip {
  margin-top: 26rpx;
  font-size: 26rpx;
  color: #3E8E4E;
  font-weight: 600;
}

.footer {
  margin-top: 50rpx;
  width: 100%;
  max-width: 620rpx;
  background: #F7FAF7;
  border-radius: 24rpx;
  padding: 30rpx 36rpx;
  box-sizing: border-box;
}

.step {
  font-size: 27rpx;
  color: #445244;
  line-height: 2.0;
}

.notice {
  margin-top: 36rpx;
  width: 100%;
  max-width: 620rpx;
  background: #FFF9EC;
  border: 2rpx solid #F3E3C0;
  border-radius: 24rpx;
  padding: 26rpx 32rpx;
  box-sizing: border-box;
}

.notice-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #8A6D3B;
  margin-bottom: 12rpx;
}

.notice-line {
  font-size: 24rpx;
  color: #9C8255;
  line-height: 1.8;
}

.home-btn {
  margin-top: 50rpx;
  width: 100%;
  max-width: 620rpx;
  background: #FFFFFF;
  color: #3E8E4E;
  border: 2rpx solid #CFE6CF;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.home-btn::after {
  border: none;
}
