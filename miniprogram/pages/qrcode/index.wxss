/* 领课二维码页 · 国风 */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0E2422 0%, #0E2422 40%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx 80rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 50rpx;
}

.tag {
  display: inline-block;
  background: rgba(201, 168, 106, 0.16);
  color: #E3C98E;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  margin-bottom: 18rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #EFE7D4;
}

.course-name {
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #C9A86A;
}

.subtitle {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #9DB0AB;
}

.card {
  width: 100%;
  max-width: 620rpx;
  background: linear-gradient(160deg, #163330, #102725);
  border: 1rpx solid rgba(201, 168, 106, 0.25);
  border-radius: 32rpx;
  padding: 36rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.4);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr {
  width: 100%;
  border-radius: 20rpx;
}

.qr-tip {
  margin-top: 26rpx;
  font-size: 26rpx;
  color: #E3C98E;
  font-weight: 600;
}

.footer {
  margin-top: 50rpx;
  width: 100%;
  max-width: 620rpx;
  background: #16332F;
  border-radius: 24rpx;
  padding: 30rpx 36rpx;
  box-sizing: border-box;
}

.step {
  font-size: 27rpx;
  color: #CFD9D2;
  line-height: 2.0;
}

.notice {
  margin-top: 36rpx;
  width: 100%;
  max-width: 620rpx;
  background: rgba(201, 168, 106, 0.1);
  border: 2rpx solid rgba(201, 168, 106, 0.25);
  border-radius: 24rpx;
  padding: 26rpx 32rpx;
  box-sizing: border-box;
}

.notice-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #E3C98E;
  margin-bottom: 12rpx;
}

.notice-line {
  font-size: 24rpx;
  color: #9DB0AB;
  line-height: 1.8;
}

.home-btn {
  margin-top: 50rpx;
  width: 100%;
  max-width: 620rpx;
  background: linear-gradient(160deg, #163330, #102725);
  color: #E3C98E;
  border: 2rpx solid rgba(201, 168, 106, 0.4);
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.home-btn::after {
  border: none;
}
