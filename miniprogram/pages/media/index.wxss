/* 抖视红视频下载 · 国风 */
.page { padding: 32rpx 28rpx 80rpx; color: #EFE7D4; }
.heading { font-size: 44rpx; font-weight: 700; margin: 12rpx 0 28rpx; color: #EFE7D4; }
.tabs { display: flex; gap: 16rpx; margin-bottom: 28rpx; }
.tabs button { flex: 1; margin: 0; }
.active, .primary { background: linear-gradient(90deg, #C9A86A, #E3C98E) !important; color: #0E2422 !important; }
.card { background: linear-gradient(160deg, #163330, #102725); border: 1rpx solid rgba(201,168,106,0.22); border-radius: 24rpx; padding: 28rpx; margin: 24rpx 0; }
.card text { display: block; line-height: 1.65; overflow-wrap: anywhere; color: #EFE7D4; }
textarea { width: 100%; height: 190rpx; background: #16332F; color: #EFE7D4; box-sizing: border-box; padding: 20rpx; margin: 24rpx 0; border-radius: 12rpx; border: 1rpx solid rgba(201,168,106,0.25); }
.title { font-size: 34rpx; font-weight: 650; color: #EFE7D4; }
.muted, .stats { font-size: 24rpx; color: #9DB0AB; margin: 12rpx 0; }
.stats { margin-bottom: 24rpx; }
video, image { width: 100%; border-radius: 12rpx; }
video { height: 430rpx; }
.row { display: flex; justify-content: space-between; margin: 20rpx 0; }
.title-row { margin: 0 0 16rpx; }
.message { white-space: pre-wrap; line-height: 1.6; }
.error { color: #C9695E; margin: 16rpx 0; }
button { font-size: 28rpx; margin-top: 18rpx; }
.foot { margin-top: 28rpx; line-height: 1.7; color: #9DB0AB; }
.link { color: #E3C98E; }
.history-item { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid rgba(201,168,106,0.15); }
.history-item:last-child { border-bottom: none; padding-bottom: 0; }
.history-hover { background: #16332F; }
.history-cover { width: 96rpx; height: 96rpx; border-radius: 12rpx; background: #16332F; flex-shrink: 0; }
.history-body { flex: 1; min-width: 0; }
.history-title { font-size: 28rpx; color: #EFE7D4; font-weight: 600; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.history-meta { font-size: 24rpx; color: #9DB0AB; margin-top: 6rpx; }
.history-arrow { font-size: 34rpx; color: #9DB0AB; }
