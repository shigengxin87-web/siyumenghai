.page{padding:32rpx 28rpx 80rpx;color:#183b30}.heading{font-size:44rpx;font-weight:700;margin:12rpx 0 28rpx}.tabs{display:flex;gap:16rpx;margin-bottom:28rpx}.tabs button{flex:1;margin:0}.active,.primary{background:#047857!important;color:#fff!important}.card{background:#fff;border:1rpx solid #d9e9e2;border-radius:24rpx;padding:28rpx;margin:24rpx 0}.card text{display:block;line-height:1.65;overflow-wrap:anywhere}textarea{width:100%;height:190rpx;background:#f3f8f5;box-sizing:border-box;padding:20rpx;margin:24rpx 0;border-radius:12rpx}.title{font-size:34rpx;font-weight:650}.muted,.stats{font-size:24rpx;color:#6b8177;margin:12rpx 0}.stats{margin-bottom:24rpx}video,image{width:100%;border-radius:12rpx}video{height:430rpx}.row{display:flex;justify-content:space-between;margin:20rpx 0}.message{white-space:pre-wrap;line-height:1.6}.error{color:#ad352f;margin:16rpx 0}button{font-size:28rpx;margin-top:18rpx}.foot{margin-top:28rpx;line-height:1.7}.link{color:#047857}
