/* AI 问答页 */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: #F6F8F6;
}

.chat-scroll {
  flex: 1;
  overflow: hidden;
}

.chat-inner {
  padding: 28rpx 32rpx 24rpx;
  box-sizing: border-box;
}

.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.chat-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #22301F;
}

.chat-clear {
  font-size: 24rpx;
  color: #6B8177;
  padding: 8rpx 0;
}

.msg {
  display: flex;
  margin-bottom: 24rpx;
}

.msg-ai {
  justify-content: flex-start;
}

.msg-user {
  justify-content: flex-end;
}

.bubble {
  max-width: 82%;
  padding: 22rpx 28rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.65;
  word-break: break-word;
  white-space: pre-wrap;
}

.msg-ai .bubble {
  background: #FFFFFF;
  color: #22301F;
  border-top-left-radius: 6rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 90, 30, 0.06);
}

.msg-user .bubble {
  background: linear-gradient(90deg, #2E7D32, #43A047);
  color: #FFFFFF;
  border-top-right-radius: 6rpx;
}

.typing {
  font-size: 24rpx;
  color: #8A9B8A;
  padding: 8rpx 8rpx 24rpx;
}

.chat-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #A9B8A9;
  padding-bottom: 40rpx;
}

.input-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 2rpx solid #EAF0EA;
}

.input {
  flex: 1;
  height: 80rpx;
  background: #F2F6F2;
  border-radius: 44rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 140rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  background: #2E7D32;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 44rpx;
}

.send-btn::after {
  border: none;
}

.send-btn[disabled] {
  background: #C5D6C5;
  color: #FFFFFF;
}

.msg-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #EAF0EA;
}

.msg-action {
  font-size: 24rpx;
  color: #6B8177;
  padding: 4rpx 0;
}

.msg-action-retry {
  color: #2E7D32;
}

/* 常驻生成说明及逐条回复标识 */
.ai-notice {
  flex-shrink: 0;
  padding: 20rpx 32rpx;
  background: #E8F3E8;
  color: #244D29;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.6;
  border-bottom: 2rpx solid #C5DDC5;
}

.ai-label {
  display: inline-block;
  margin-bottom: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #E8F3E8;
  color: #244D29;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.6;
  white-space: normal;
}
