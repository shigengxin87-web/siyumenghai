/* AI 问答页 · 国风（深墨绿底 + 香槟金） */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: #0E2422;
}

.chat-scroll {
  flex: 1;
  overflow: hidden;
}

.chat-inner {
  padding: 12rpx 32rpx 24rpx;
  box-sizing: border-box;
}

.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
  padding: 20rpx 32rpx 16rpx;
  background: #0E2422;
}

.chat-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #EFE7D4;
}

.chat-header-actions {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.chat-profile {
  font-size: 24rpx;
  color: #C9A86A;
  padding: 8rpx 0;
}

.chat-clear {
  font-size: 24rpx;
  color: #9DB0AB;
  padding: 8rpx 0;
}

.msg {
  display: flex;
  margin-bottom: 24rpx;
}

.msg-ai {
  justify-content: flex-start;
}

.msg-user {
  justify-content: flex-end;
}

.bubble {
  max-width: 82%;
  padding: 22rpx 28rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.65;
  word-break: break-word;
  white-space: pre-wrap;
}

.msg-ai .bubble {
  background: linear-gradient(160deg, #163330, #102725);
  color: #EFE7D4;
  border-top-left-radius: 6rpx;
  border: 1rpx solid rgba(201, 168, 106, 0.22);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
}

.msg-user .bubble {
  background: linear-gradient(90deg, #C9A86A, #E3C98E);
  color: #0E2422;
  border-top-right-radius: 6rpx;
}

.typing {
  font-size: 24rpx;
  color: #9DB0AB;
  padding: 8rpx 8rpx 24rpx;
}

.chat-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #6E857F;
  padding-bottom: 40rpx;
}

.input-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #16332F;
  border-top: 2rpx solid rgba(201, 168, 106, 0.2);
}

.input {
  flex: 1;
  height: 80rpx;
  background: #0E2422;
  border-radius: 44rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #EFE7D4;
  border: 1rpx solid rgba(201, 168, 106, 0.25);
}

.send-btn {
  width: 140rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  background: linear-gradient(90deg, #C9A86A, #E3C98E);
  color: #0E2422;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 44rpx;
}

.send-btn::after {
  border: none;
}

.send-btn[disabled] {
  background: #3A4A45;
  color: #8A9B8A;
}

.msg-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(201, 168, 106, 0.18);
}

.msg-action {
  font-size: 24rpx;
  color: #9DB0AB;
  padding: 4rpx 0;
}

.msg-action-retry {
  color: #E3C98E;
}

/* 常驻生成说明及逐条回复标识 */
.ai-notice {
  flex-shrink: 0;
  padding: 16rpx 32rpx;
  background: #0E2422;
  color: #9DB0AB;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
  border-bottom: 1rpx solid rgba(201, 168, 106, 0.18);
}

.ai-label {
  display: inline-block;
  margin-bottom: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(201, 168, 106, 0.16);
  color: #E3C98E;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.6;
  white-space: normal;
}

/* 首次进入的档案引导卡片 */
.guide-card {
  margin: 8rpx 0 28rpx;
  padding: 24rpx 26rpx 20rpx;
  background: linear-gradient(160deg, #163330, #102725);
  border: 2rpx solid rgba(201, 168, 106, 0.3);
  border-radius: 20rpx;
}

.guide-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.guide-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #EFE7D4;
  line-height: 1.5;
}

.guide-close {
  flex-shrink: 0;
  margin: -6rpx 0 0 16rpx;
  padding: 0 4rpx;
  font-size: 34rpx;
  line-height: 1;
  color: #9DB0AB;
}

.guide-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #9DB0AB;
}

.guide-actions {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 18rpx;
}

.guide-btn {
  font-size: 25rpx;
  font-weight: 600;
  color: #E3C98E;
  padding: 6rpx 0;
}

.guide-later {
  font-size: 25rpx;
  color: #9DB0AB;
  padding: 6rpx 0;
}

/* AI 回答里的链接 / 图片 / 视频：可直接交互 */
.bubble-rich {
  display: block;
  white-space: pre-wrap;
}

.rich-text {
  white-space: pre-wrap;
}

.rich-link {
  color: #E3C98E;
  text-decoration: underline;
  word-break: break-all;
}

.rich-image {
  display: block;
  width: 100%;
  margin: 12rpx 0;
  border-radius: 16rpx;
  background: #16332F;
}

.rich-video {
  width: 100%;
  margin: 12rpx 0;
}

.rich-video-el {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  background: #000;
}

.rich-save {
  display: inline-block;
  margin-top: 8rpx;
  padding: 8rpx 24rpx;
  background: rgba(201, 168, 106, 0.16);
  color: #E3C98E;
  font-size: 24rpx;
  border-radius: 999rpx;
}
