<view class="chat-page">
  <view class="ai-notice">由 AI 分身生成，若未解决问题联系石更新真人解答。</view>
  <!-- 标题与入口常驻，不随消息滚走 -->
  <view class="chat-header">
    <text class="chat-title">AI 问答</text>
    <view class="chat-header-actions">
      <text class="chat-profile" bindtap="goProfile">我的情况</text>
      <text class="chat-clear" bindtap="clearChat">清空会话</text>
    </view>
  </view>
  <!-- 消息流 -->
  <scroll-view
    class="chat-scroll"
    scroll-y="true"
    scroll-top="{{scrollTop}}"
    bindscroll="onScroll"
  >
    <view class="chat-inner">
      <view
        class="msg {{item.role === 'user' ? 'msg-user' : 'msg-ai'}}"
        wx:for="{{messages}}"
        wx:key="id"
        id="msg-{{index}}"
      >
        <view class="bubble">
          <view class="ai-label" wx:if="{{item.role === 'assistant'}}">AI 分身</view>
          <view wx:if="{{item.segments}}" class="bubble-rich">
            <block wx:for="{{item.segments}}" wx:for-item="seg" wx:key="index">
              <text wx:if="{{seg.type === 'text'}}" user-select="true" class="rich-text">{{seg.text}}</text>
              <text wx:elif="{{seg.type === 'link'}}" class="rich-link" data-url="{{seg.url}}" catchtap="onLinkTap">{{seg.display}}</text>
              <image wx:elif="{{seg.type === 'image'}}" class="rich-image" src="{{seg.url}}" mode="widthFix" data-url="{{seg.url}}" show-menu-by-longpress="{{true}}" bindtap="onImageTap" binderror="onMediaError"></image>
              <view wx:elif="{{seg.type === 'video'}}" class="rich-video">
                <video class="rich-video-el" src="{{seg.url}}" controls="{{true}}" show-center-play-btn="{{true}}" object-fit="contain" binderror="onMediaError"></video>
                <view class="rich-save" data-url="{{seg.url}}" catchtap="onSaveMedia">保存到相册</view>
              </view>
            </block>
          </view>
          <text wx:else user-select="true">{{item.text}}</text>
          <view class="msg-actions" wx:if="{{item.role === 'assistant'}}">
            <text class="msg-action" catchtap="copyMessage" data-id="{{item.id}}">复制</text>
            <text class="msg-action msg-action-retry" wx:if="{{item.canRetry}}" catchtap="retryMessage" data-id="{{item.id}}">重试</text>
          </view>
        </view>
      </view>
      <view class="typing" wx:if="{{sending && !firstToken}}">更新哥正在思考…</view>
      <!-- 首次引导：不打断对话，只在没填过档案时出现一次 -->
      <view class="guide-card" wx:if="{{showGuide}}">
        <view class="guide-head">
          <text class="guide-title">花 30 秒说一下你的情况</text>
          <text class="guide-close" catchtap="hideGuide">×</text>
        </view>
        <text class="guide-desc">做什么行业、卖什么、多大规模——填过我直接给方案，不再问你第二遍。</text>
        <view class="guide-actions">
          <text class="guide-btn" catchtap="goProfile">去填写</text>
          <text class="guide-later" catchtap="hideGuide">以后再说</text>
        </view>
      </view>
      <view class="chat-tip">回答基于石董会知识库，仅供社群成员参考</view>
    </view>
  </scroll-view>

  <!-- 输入栏 -->
  <view class="input-bar">
    <input
      class="input"
      value="{{input}}"
      bindinput="onInput"
      confirm-type="send"
      bindconfirm="send"
      placeholder="输入你的运营问题…"
      disabled="{{sending}}"
    />
    <button class="send-btn" bindtap="send" disabled="{{sending || !input}}">发送</button>
  </view>
</view>
