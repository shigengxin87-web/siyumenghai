<view class="page">
  <view class="kb-head">
    <view class="kb-title">内容沉淀都在这里</view>
    <view class="kb-sub">ima 可点击直达；飞书因平台限制仅支持复制后在浏览器打开</view>
  </view>

  <view
    class="kb-card card"
    wx:for="{{items}}"
    wx:key="key"
    bindtap="onTap"
    data-key="{{item.key}}"
  >
    <view class="kb-icon">{{item.icon}}</view>
    <view class="kb-body">
      <view class="kb-name">{{item.title}}</view>
      <view class="kb-desc">{{item.desc}}</view>
    </view>
    <view class="kb-action">{{item.mode === 'copy' ? '复制 ↗' : '打开 ›'}}</view>
  </view>

  <view class="footer-tip">石董会 · 一起成长朋友圈</view>
</view>
