/* 知识库 · 国风 */
.kb-head {
  padding: 8rpx 8rpx 28rpx;
}

.kb-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #EFE7D4;
}

.kb-sub {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #9DB0AB;
  line-height: 1.7;
}

.kb-card {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 30rpx 32rpx;
}

.kb-icon {
  font-size: 52rpx;
  flex-shrink: 0;
}

.kb-body {
  flex: 1;
  margin-left: 26rpx;
}

.kb-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #EFE7D4;
}

.kb-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9DB0AB;
}

.kb-action {
  font-size: 26rpx;
  color: #C9A86A;
  font-weight: 600;
}
