<view class="members-page page-enter">
  <view class="members-hero">
    <view><text class="kicker">WHO'S HERE</text><text class="title">群友名录</text></view>
    <view class="member-total"><text>{{members.length}}</text><text>位群友</text></view>
    <text class="desc">按进群时间排列。这里展示大家在群里的公开昵称和头像。</text>
  </view>
  <view class="search-wrap"><view class="search-box"><text>⌕</text><input type="text" value="{{query}}" placeholder="输入昵称查找" confirm-type="search" bindinput="onSearch" /></view></view>
  <view class="result-count"><text>找到 {{filteredMembers.length}} 位群友</text><text>按进群顺序</text></view>
  <view class="member-grid">
    <view class="member-card" wx:for="{{filteredMembers}}" wx:key="order">
      <text class="number">{{item.number}}</text>
      <image src="{{item.avatar}}" mode="aspectFill" lazy-load="true" />
      <text class="name">{{item.name}}</text>
    </view>
  </view>
  <view class="empty" wx:if="{{!filteredMembers.length}}">没有找到这个昵称，换个关键词试试。</view>
  <view class="safe-bottom"></view>
</view>
