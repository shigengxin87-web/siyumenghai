<view class="page-shell">
  <view class="app-head">
    <view class="brand-row">
      <image class="brand-avatar" src="/assets/brand-avatar.jpg" mode="aspectFill" />
      <view class="brand-copy"><text>石董会 · 成长朋友圈</text><text>群友学习版</text></view>
      <view class="sync-pill"><text class="live-dot"></text> 已同步</view>
    </view>
    <view class="welcome-row">
      <view><text class="eyebrow">TODAY'S BRIEF</text><text class="welcome-title">今天，从群里带走什么？</text></view>
      <button class="share-button" open-type="share">分享</button>
    </view>
  </view>

  <view class="date-panel">
    <picker mode="selector" range="{{dateOptions}}" range-key="fullLabel" value="{{selectedDateIndex}}" bindchange="onDateChange">
      <view class="date-picker"><view><text>{{report.weekday}}</text><text class="strong">{{report.dateLabel}}</text></view><text class="switch-copy">切换日期⌄</text></view>
    </picker>
    <scroll-view class="date-chips" scroll-x="true" enhanced="true" show-scrollbar="false" scroll-into-view="date-{{selectedKey}}" scroll-with-animation="true">
      <view class="date-chips-inner">
        <button id="date-{{item.key}}" wx:for="{{recentDateOptions}}" wx:key="key" class="date-chip {{item.key === selectedKey ? 'is-active' : ''}}" data-key="{{item.key}}" bindtap="selectDate"><text>{{item.day}}</text><text>{{item.shortLabel}}</text></button>
      </view>
    </scroll-view>
  </view>

  <scroll-view class="view-tabs" scroll-x="true" enhanced="true" show-scrollbar="false" scroll-into-view="view-{{currentView}}" scroll-with-animation="true">
    <view class="view-tabs-inner">
      <button id="view-{{item.id}}" wx:for="{{views}}" wx:key="id" class="view-tab {{item.id === currentView ? 'is-active' : ''}}" data-view="{{item.id}}" bindtap="switchView"><text>{{item.number}}</text>{{item.label}}</button>
    </view>
  </scroll-view>

  <view class="content page-enter" wx:if="{{currentView === 'overview'}}">
    <view class="lead-card card">
      <view class="lead-meta"><text>{{report.weekday}} · 今日一句话</text><text>{{report.readTime}}</text></view>
      <text class="lead-title">{{report.title}}</text>
      <text class="lead-summary">{{report.summary}}</text>
      <view class="lead-actions"><button bindtap="copyToday">复制重点</button><button data-view="actions" bindtap="switchView">马上行动 →</button></view>
    </view>

    <view class="stats-card card">
      <view><text class="strong">{{report.messages}}</text><text>群聊消息</text></view>
      <view><text class="strong">{{report.themesCount}}</text><text>讨论主题</text></view>
      <view><text class="strong">{{report.insights.length}}</text><text>关键启发</text></view>
    </view>

    <view class="section-head"><view><text class="kicker">对我有什么启发</text><text class="strong">今天最值得带走的内容</text></view></view>
    <scroll-view class="lens-scroll" scroll-x="true" show-scrollbar="false">
      <view class="lens-row"><button wx:for="{{lensOptions}}" wx:key="id" class="lens-chip {{activeLens === item.id ? 'is-active' : ''}}" data-lens="{{item.id}}" bindtap="switchLens">{{item.label}}</button></view>
    </scroll-view>
    <view class="insight card" wx:for="{{visibleInsights}}" wx:key="title">
      <view class="insight-index">{{item.displayIndex}}</view>
      <view class="insight-body">
        <view class="insight-meta"><text class="tag">{{item.tag}}</text><text>{{item.time}}</text></view>
        <text class="strong">{{item.title}}</text><text>{{item.text}}</text><text class="small">来自 {{item.source}}</text>
        <view class="content-links" wx:if="{{item.links.length}}"><button wx:for="{{item.links}}" wx:for-item="link" wx:key="url" data-url="{{link.url}}" bindtap="copyLink">{{link.label}} ↗</button></view>
      </view>
    </view>
    <view class="empty-card" wx:if="{{!visibleInsights.length}}">今天暂时没有这个方向的内容，换一个筛选看看。</view>
  </view>

  <view class="content page-enter" wx:elif="{{currentView === 'actions'}}">
    <view class="section-head"><view><text class="kicker">把启发变成动作</text><text class="strong">今天可以做的小事</text></view><text class="progress-copy">{{completedCount}} / {{report.actions.length}}</text></view>
    <view class="progress-track"><view style="width: {{actionProgress}}%"></view></view>
    <checkbox-group wx:for="{{report.actions}}" wx:key="title" data-index="{{index}}" bindchange="toggleAction">
      <label class="action-card card {{completedActions[index] ? 'is-done' : ''}}">
        <checkbox value="done" checked="{{completedActions[index]}}" color="#07966f" />
        <view><text class="action-number">行动 {{index + 1}}</text><text class="strong">{{item.title}}</text><text>{{item.text}}</text><view class="content-links" wx:if="{{item.links.length}}"><button wx:for="{{item.links}}" wx:for-item="link" wx:key="url" data-url="{{link.url}}" catchtap="copyLink">{{link.label}} ↗</button></view></view>
      </label>
    </checkbox-group>
    <view class="tip">每个人的勾选状态只保存在自己的手机上，不会影响其他群友。</view>
  </view>

  <view class="content page-enter" wx:elif="{{currentView === 'weekly'}}">
    <view class="section-head"><view><text class="kicker">7 DAY REVIEW · 七日回顾</text><text class="strong">把连续讨论，看成一条成长路径</text></view></view>
    <view class="weekly-summary card"><text class="strong">先看见真正的结果，再用内容与关系把价值留下来</text><text>理解需求 → 表达价值 → 建立信任 → 沉淀关系资产</text></view>
    <view class="stats-card card">
      <view><text class="strong">{{weekly.messages}}</text><text>群聊消息</text></view><view><text class="strong">{{weekly.themes}}</text><text>讨论主题</text></view><view><text class="strong">{{weekly.actions}}</text><text>行动建议</text></view>
    </view>
    <view class="week-card card" wx:for="{{weekly.days}}" wx:key="key" data-key="{{item.key}}" bindtap="openDay">
      <view><text>{{item.dateLabel}} · {{item.weekday}}</text><text class="strong">{{item.title}}</text></view><text class="week-arrow">›</text>
    </view>
  </view>

  <view class="content page-enter" wx:elif="{{currentView === 'topics'}}">
    <view class="section-head"><view><text class="kicker">KNOWLEDGE PATHS · 专题沉淀</text><text class="strong">从自己的问题出发，重新找到内容</text></view></view>
    <view class="topic-switch"><button wx:for="{{topicOptions}}" wx:key="id" class="{{activeTopic === item.id ? 'is-active' : ''}}" data-topic="{{item.id}}" bindtap="switchTopic">{{item.label}}</button></view>
    <view class="topic-intro card"><text class="topic-count">{{topicCollection.items.length}} 条沉淀</text><text class="strong">{{topicCollection.title}}</text><text>{{topicCollection.description}}</text></view>
    <view class="topic-item card" wx:for="{{topicCollection.items}}" wx:key="uniqueKey" data-key="{{item.key}}" bindtap="openDay">
      <view><text class="topic-date">{{item.dateLabel}}</text><text class="strong">{{item.title}}</text><text>{{item.source}} · {{item.time}}</text></view><text class="week-arrow">›</text>
    </view>
  </view>

  <view class="content page-enter" wx:elif="{{currentView === 'resources'}}">
    <view class="section-head"><view><text class="kicker">资源连接</text><text class="strong">今天值得记住的人、工具与方法</text></view></view>
    <view class="resource-card card" wx:for="{{report.resources}}" wx:key="title">
      <text class="tag">{{item.kind}}</text><text class="strong">{{item.title}}</text><text>{{item.text}}</text>
      <view class="content-links" wx:if="{{item.links.length}}"><button wx:for="{{item.links}}" wx:for-item="link" wx:key="url" data-url="{{link.url}}" bindtap="copyLink">{{link.label}} ↗</button></view>
    </view>
  </view>

  <view class="content page-enter" wx:elif="{{currentView === 'discussion'}}">
    <view class="section-head"><view><text class="kicker">原始讨论</text><text class="strong">群里今天聊了什么</text></view></view>
    <view class="timeline card">
      <view class="timeline-item" wx:for="{{report.themes}}" wx:key="title"><view class="timeline-axis"><text>{{item.time}}</text><view></view></view><view class="timeline-copy"><text class="strong">{{item.title}}</text><text>{{item.text}}</text><view class="content-links" wx:if="{{item.links.length}}"><button wx:for="{{item.links}}" wx:for-item="link" wx:key="url" data-url="{{link.url}}" bindtap="copyLink">{{link.label}} ↗</button></view></view></view>
    </view>
    <view class="tip"><text class="strong">阅读边界：</text>这是学习索引，不是聊天替代品。涉及具体合作、价格和个人观点时，请以群内原始消息为准。</view>
  </view>

  <view class="safe-bottom"></view>
</view>
