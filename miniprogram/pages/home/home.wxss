/* 首页 · 国风 */
.hero {
  background: radial-gradient(120% 110% at 50% 0%, #1A3A37 0%, #0E2422 72%);
  border: 1rpx solid rgba(201, 168, 106, 0.25);
  border-radius: 36rpx;
  padding: 56rpx 40rpx 48rpx;
  text-align: center;
  overflow: hidden;
}

.hero-badge {
  display: inline-block;
  margin-top: 18rpx;
  background: rgba(201, 168, 106, 0.12);
  border: 1rpx solid rgba(201, 168, 106, 0.4);
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #E3C98E;
}

.hero-slogan {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(227, 201, 142, 0.85);
  letter-spacing: 1rpx;
}

.quote-card {
  margin-top: 28rpx;
  background: linear-gradient(160deg, #163330, #102725);
  border: 1rpx solid rgba(201, 168, 106, 0.28);
}

.quote-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #EFE7D4;
  line-height: 1.7;
}

.quote-note {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #C9A86A;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  margin-top: 28rpx;
}

.grid-item {
  padding: 34rpx 28rpx;
}

/* 电脑端（窗口较宽）：多列并排，避免卡片被拉得过长 */
@media (min-width: 600px) {
  .page {
    max-width: 1000px;
    margin: 0 auto;
  }
  .grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (min-width: 960px) {
  .grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.grid-icon {
  font-size: 48rpx;
}

.grid-title {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #EFE7D4;
}

.grid-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #9DB0AB;
}
