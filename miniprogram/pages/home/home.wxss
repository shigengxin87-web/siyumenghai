/* 首页 */
.hero {
  background: linear-gradient(160deg, #1F5E2C 0%, #2E7D32 55%, #43A047 100%);
  border-radius: 36rpx;
  padding: 52rpx 40rpx 56rpx;
  color: #FFFFFF;
  overflow: hidden;
}

.hero-badge {
  display: inline-block;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 28rpx;
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
}

.hero-slogan {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

.quote-card {
  margin-top: 28rpx;
  background: #FFFDF6;
  border: 2rpx solid #F3E3C0;
}

.quote-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #5C4521;
  line-height: 1.7;
}

.quote-note {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #9C8255;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 28rpx;
}

.grid-item {
  width: 48%;
  margin-bottom: 24rpx;
  padding: 34rpx 28rpx;
}

.grid-icon {
  font-size: 48rpx;
}

.grid-title {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #22301F;
}

.grid-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8A9B8A;
}

.about {
  margin-top: 28rpx;
}

.about-title {
  font-size: 32rpx;
  font-weight: 700;
}

.about-text {
  margin-top: 16rpx;
  font-size: 27rpx;
  color: #4C6B4C;
  line-height: 1.8;
}
