/* 技巧列表 · 国风 */
.search-bar {
  display: flex;
  align-items: center;
  background: #16332F;
  border: 2rpx solid rgba(201, 168, 106, 0.25);
  border-radius: 999rpx;
  padding: 0 24rpx;
  margin: 8rpx 0 24rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
  color: #EFE7D4;
}

.search-clear {
  font-size: 24rpx;
  color: #9DB0AB;
  padding: 8rpx 0 8rpx 16rpx;
}

.empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9DB0AB;
}

.cats {
  white-space: nowrap;
  margin: 8rpx 0 28rpx;
}

.cat {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 18rpx;
  background: #16332F;
  border: 2rpx solid rgba(201, 168, 106, 0.25);
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #CFD9D2;
}

.cat-active {
  background: linear-gradient(90deg, #C9A86A, #E3C98E);
  border-color: #C9A86A;
  color: #0E2422;
  font-weight: 600;
}

.tip-card {
  margin-bottom: 24rpx;
  position: relative;
  padding-right: 72rpx;
}

.tip-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tip-cat {
  display: inline-block;
  background: rgba(201, 168, 106, 0.16);
  color: #E3C98E;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.tip-note {
  font-size: 20rpx;
  color: #9DB0AB;
}

.tip-fav {
  font-size: 24rpx;
  color: #9DB0AB;
  padding: 6rpx 16rpx;
  border: 2rpx solid rgba(201, 168, 106, 0.25);
  border-radius: 999rpx;
}

.tip-fav.is-fav {
  color: #E3C98E;
  border-color: rgba(201, 168, 106, 0.5);
  background: rgba(201, 168, 106, 0.12);
}

.tip-fav-hover {
  background: rgba(201, 168, 106, 0.12);
}

.tip-title {
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #EFE7D4;
  line-height: 1.45;
}

.tip-summary {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #9DB0AB;
  line-height: 1.7;
}

.tip-arrow {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: #9DB0AB;
}
