/* 技巧列表 */
.search-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 2rpx solid #E3EBE3;
  border-radius: 999rpx;
  padding: 0 24rpx;
  margin: 8rpx 0 24rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
}

.search-clear {
  font-size: 24rpx;
  color: #8A9B8A;
  padding: 8rpx 0 8rpx 16rpx;
}

.empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #8A9B8A;
}

.cats {
  white-space: nowrap;
  margin: 8rpx 0 28rpx;
}

.cat {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 18rpx;
  background: #FFFFFF;
  border: 2rpx solid #E3EBE3;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #4C6B4C;
}

.cat-active {
  background: #2E7D32;
  border-color: #2E7D32;
  color: #FFFFFF;
  font-weight: 600;
}

.tip-card {
  margin-bottom: 24rpx;
  position: relative;
  padding-right: 72rpx;
}

.tip-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tip-cat {
  display: inline-block;
  background: #E8F5E8;
  color: #2E7D32;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.tip-note {
  font-size: 20rpx;
  color: #C0CCC0;
}

.tip-fav {
  font-size: 24rpx;
  color: #8A9B8A;
  padding: 6rpx 16rpx;
  border: 2rpx solid #E3EBE3;
  border-radius: 999rpx;
}

.tip-fav.is-fav {
  color: #2E7D32;
  border-color: #B9DCBB;
  background: #F2FAF2;
}

.tip-fav-hover {
  background: #E8F5E8;
}

.tip-title {
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #22301F;
  line-height: 1.45;
}

.tip-summary {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #6E8A6E;
  line-height: 1.7;
}

.tip-arrow {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: #C0CCC0;
}
