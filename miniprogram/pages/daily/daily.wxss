/* 每日内容 · 国风 */
.daily-page {
  padding: 28rpx 28rpx 0;
  background: #0E2422;
  min-height: 100vh;
}

.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cal-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #EFE7D4;
}

.cal-nav {
  display: flex;
  align-items: center;
}

.cal-arrow {
  font-size: 44rpx;
  color: #C9A86A;
  padding: 0 24rpx;
}

.cal-today {
  font-size: 26rpx;
  color: #C9A86A;
  border: 2rpx solid rgba(201, 168, 106, 0.5);
  border-radius: 999rpx;
  padding: 6rpx 22rpx;
}

.cal-week {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-top: 28rpx;
}

.cal-wd {
  text-align: center;
  font-size: 24rpx;
  color: #9DB0AB;
  padding: 12rpx 0;
}

.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
  margin-top: 8rpx;
}

.cal-cell {
  position: relative;
  aspect-ratio: 1 / 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: linear-gradient(160deg, #163330, #102725);
  border: 1rpx solid rgba(201, 168, 106, 0.18);
}

.cal-cell.out {
  opacity: 0.35;
}

.cal-cell.has {
  background: linear-gradient(160deg, #1E4039, #143028);
  border-color: rgba(201, 168, 106, 0.5);
}

.cal-cell.today {
  outline: 3rpx solid #C9A86A;
  outline-offset: -3rpx;
}

.cal-day {
  font-size: 30rpx;
  color: #EFE7D4;
}

.cal-dot {
  position: absolute;
  bottom: 8rpx;
  font-size: 14rpx;
  color: #C9A86A;
  line-height: 1;
}

.cal-hint {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #9DB0AB;
}

.recent {
  margin-top: 36rpx;
}

.recent-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #EFE7D4;
  margin-bottom: 16rpx;
}

.recent-item {
  background: linear-gradient(160deg, #163330, #102725);
  border: 1rpx solid rgba(201, 168, 106, 0.18);
  border-radius: 18rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 16rpx;
}

.recent-date {
  font-size: 23rpx;
  color: #9DB0AB;
}

.recent-name {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #EFE7D4;
}

.safe-bottom {
  height: 40rpx;
}
