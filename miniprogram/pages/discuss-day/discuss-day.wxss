/* 原始讨论页 · 国风 */
.loading,
.error {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9DB0AB;
}

/* 系统消息 */
.sys {
  background: #16332F;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin: 20rpx 0;
  text-align: center;
}

.sys-time {
  font-size: 20rpx;
  color: #9DB0AB;
}

.sys-text {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #CFD9D2;
  line-height: 1.6;
}

/* 普通消息 */
.msg {
  margin-bottom: 28rpx;
}

.msg-meta {
  font-size: 22rpx;
  color: #9DB0AB;
  margin-bottom: 10rpx;
  padding-left: 8rpx;
}

.msg-bubble {
  background: linear-gradient(160deg, #163330, #102725);
  border: 1rpx solid rgba(201, 168, 106, 0.18);
  border-radius: 22rpx;
  padding: 22rpx 26rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.3);
}

.msg-text {
  font-size: 28rpx;
  color: #EFE7D4;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}

.msg-img {
  margin-top: 16rpx;
  width: 100%;
  border-radius: 16rpx;
}

.msg-media {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #9DB0AB;
  background: #16332F;
  border-radius: 12rpx;
  padding: 12rpx 18rpx;
}

.msg-links {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.msg-link {
  font-size: 23rpx;
  color: #E3C98E;
  background: rgba(201, 168, 106, 0.12);
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
}

.msg-redacted {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #C9A86A;
}
