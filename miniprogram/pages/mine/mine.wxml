<view class="page">
  <!-- 身份卡 -->
  <view class="profile card">
    <view class="avatar">{{brand[0]}}</view>
    <view class="profile-body">
      <view class="profile-name">{{brand}} 成员</view>
      <view class="profile-slogan">{{slogan}}</view>
    </view>
  </view>

  <!-- 我的收藏 -->
  <view class="fav-entry card" bindtap="openFavorites">
    <view><text class="tool-title">我的收藏</text><text class="tool-desc">收藏的技巧与讨论，方便随时回看</text></view>
    <text class="arrow">›</text>
  </view>

  <!-- 关于 -->
  <view class="about card">
    <view class="about-title">关于石董会</view>
    <view class="about-text">石董会「一起成长朋友圈」：高信息密度的运营实战社群，每天有真实案例拆解、AI 新技能学习和群友互助讨论。群里聊过的好东西，都会沉淀成你能带走的方法。</view>
  </view>

  <!-- 权益说明 -->
  <view class="benefit card">
    <view class="benefit-title">成员权益</view>
    <view class="benefit-line">· 每日原始讨论与日报回顾</view>
    <view class="benefit-line">· 运营技巧库与延伸阅读</view>
    <view class="benefit-line">· AI 问答：基于 128 个实战案例知识库</view>
    <view class="benefit-line">· 视频号 / 抖音 / 小红书 原生保存到相册</view>
    <view class="benefit-line">· 飞书 / ima 知识库</view>
  </view>

  <view class="footer-tip">石董会 · {{version}}</view>
</view>
