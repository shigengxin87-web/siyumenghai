/* 我的收藏 · 国风 */
.fav-head {
  padding: 8rpx 8rpx 24rpx;
}

.fav-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #EFE7D4;
}

.fav-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9DB0AB;
  line-height: 1.7;
}

.types {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.type {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 18rpx;
  background: #16332F;
  border: 2rpx solid rgba(201, 168, 106, 0.25);
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #CFD9D2;
}

.type-active {
  background: linear-gradient(90deg, #C9A86A, #E3C98E);
  border-color: #C9A86A;
  color: #0E2422;
  font-weight: 600;
}

.fav-card {
  padding: 28rpx 30rpx;
}

.fav-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.fav-tag {
  display: inline-block;
  background: rgba(201, 168, 106, 0.16);
  color: #E3C98E;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.fav-arrow {
  font-size: 36rpx;
  color: #9DB0AB;
}

.fav-title-text {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #EFE7D4;
  line-height: 1.45;
}

.fav-sub-text {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9DB0AB;
  line-height: 1.7;
}

.fav-actions {
  display: flex;
  gap: 28rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(201, 168, 106, 0.15);
}

.fav-action {
  font-size: 24rpx;
  color: #9DB0AB;
}

.fav-remove {
  color: #C9695E;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9DB0AB;
  line-height: 1.8;
}
