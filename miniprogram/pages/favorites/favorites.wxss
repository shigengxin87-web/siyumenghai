/* 我的收藏 */
.fav-head {
  padding: 8rpx 8rpx 24rpx;
}

.fav-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #22301F;
}

.fav-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8A9B8A;
  line-height: 1.7;
}

.types {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.type {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 18rpx;
  background: #FFFFFF;
  border: 2rpx solid #E3EBE3;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #4C6B4C;
}

.type-active {
  background: #2E7D32;
  border-color: #2E7D32;
  color: #FFFFFF;
  font-weight: 600;
}

.fav-card {
  padding: 28rpx 30rpx;
}

.fav-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.fav-tag {
  display: inline-block;
  background: #E8F5E8;
  color: #2E7D32;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.fav-arrow {
  font-size: 36rpx;
  color: #C0CCC0;
}

.fav-title-text {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #22301F;
  line-height: 1.45;
}

.fav-sub-text {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6E8A6E;
  line-height: 1.7;
}

.fav-actions {
  display: flex;
  gap: 28rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EAF0EA;
}

.fav-action {
  font-size: 24rpx;
  color: #6B8177;
}

.fav-remove {
  color: #C1554F;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #8A9B8A;
  line-height: 1.8;
}