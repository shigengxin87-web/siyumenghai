[Unit]
Description=Siyumenghai RAG-Lite (Dify-compatible AI backend)
After=network.target

[Service]
Type=simple
ExecStart=/opt/siyumenghai-rag-lite/venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8080 --workers 1
WorkingDirectory=/opt/siyumenghai-rag-lite
EnvironmentFile=/opt/siyumenghai-rag-lite/env
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
