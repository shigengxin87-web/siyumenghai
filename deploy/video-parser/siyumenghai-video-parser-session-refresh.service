[Unit]
Description=Refresh Yuanbao session and verify Siyumenghai video parser
After=network-online.target lighthouse-chromium.service
Wants=network-online.target lighthouse-chromium.service

[Service]
Type=oneshot
User=root
ExecStart=/bin/systemctl restart siyumenghai-video-parser.service
ExecStart=/usr/local/bin/siyumenghai-video-parser-healthcheck
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/siyumenghai-video-parser /var/lib/siyumenghai-video-parser
