[Unit]
Description=Siyumenghai Xiaohongshu cloud browser worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=siyumenghai-xhs
Group=siyumenghai-xhs
Environment=HOME=/var/lib/siyumenghai-xhs-browser
Environment=XDG_CONFIG_HOME=/var/lib/siyumenghai-xhs-browser/config
Environment=XDG_CACHE_HOME=/var/lib/siyumenghai-xhs-browser/cache
ExecStart=/usr/bin/google-chrome --headless=new --disable-gpu --disable-dev-shm-usage --disable-crash-reporter --disable-breakpad --no-first-run --no-default-browser-check --remote-debugging-address=127.0.0.1 --remote-debugging-port=9223 --remote-allow-origins=* --user-data-dir=/var/lib/siyumenghai-xhs-browser/profile about:blank
Restart=always
RestartSec=8
MemoryHigh=580M
MemoryMax=700M
TasksMax=250
TimeoutStopSec=20
UMask=0077

[Install]
WantedBy=multi-user.target
