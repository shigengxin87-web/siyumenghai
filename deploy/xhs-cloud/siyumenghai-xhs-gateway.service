[Unit]
Description=Siyumenghai Xiaohongshu media gateway
After=network-online.target siyumenghai-xhs-engine.service
Wants=siyumenghai-xhs-engine.service
[Service]
User=siyumenghai-xhs
Group=siyumenghai-xhs
WorkingDirectory=/opt/siyumenghai-xhs-cloud
EnvironmentFile=/etc/siyumenghai-xhs/cloud.env
ExecStart=/opt/siyumenghai-xhs-cloud/runtime/node gateway.mjs
Restart=on-failure
RestartSec=5
MemoryHigh=180M
MemoryMax=240M
CPUQuota=40%
TasksMax=32
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/siyumenghai-xhs-media
UMask=0077
[Install]
WantedBy=multi-user.target
