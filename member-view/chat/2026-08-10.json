    {
      "id": "m028",
      "time": "2026-08-10 19:00:04",
      "sender": "石更新（23:00睡觉）",
      "avatar": "./assets/members/member-01.jpg?v=20260917192332",
      "side": "right",
      "type": "text",
      "text": "视频号导流私域的五大场景\n\nhttps://my.feishu.cn/wiki/BcurwyEubiWciukkHdycLyxtnfe?from=from_copylink\n\n @百合",
      "links": [],
