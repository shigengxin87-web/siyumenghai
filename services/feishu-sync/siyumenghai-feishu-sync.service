[Unit]
Description=Siyumenghai verified Feishu transcript saves
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/siyumenghai-feishu-sync
ExecStart=/usr/bin/python3 /opt/siyumenghai-feishu-sync/server.py
Restart=on-failure
RestartSec=3
StateDirectory=siyumenghai-feishu-sync
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/siyumenghai-feishu-sync

[Install]
WantedBy=multi-user.target
